{
  "name": "@crithits/eslint-config-react",
  "version": "1.0.0",
  "description": "Shared ESLint flat config for React + TypeScript (React Compiler rules, strict typescript-eslint, a11y)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.74.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=5.8 <6.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "eslint": "^10.15.0",
    "react": "^19.3.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crithits/agent-standards.git",
    "directory": "packages/eslint-config-react"
  }
}
