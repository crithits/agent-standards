{
  "name": "agent-standards",
  "private": true,
  "description": "Shared lint config, tsconfig, and coding-agent rules for React + TypeScript repos",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.md\"",
    "format:check": "prettier --check \"**/*.md\""
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
